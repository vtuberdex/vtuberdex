{
  "name": "vtuberdex",
  "private": true,
  "version": "0.1.0",
  "description": "VTuberDex: catálogo de VTubers hispanohablantes con carta holográfica 3D",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-db.mjs --if-missing && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:shaders": "node scripts/check-shaders.mjs",
    "verify": "node scripts/verify-vercel-bundle.mjs",
    "probe:timings": "node scripts/probe-timings.mjs",
    "bench:ediciones": "node scripts/bench-ediciones.mjs",
    "marcar:graduados": "node scripts/marcar-graduados.mjs",
    "sweep:dead-code": "node scripts/sweep-dead-code.mjs",
    "build:data": "node scripts/build-db.mjs",
    "publish:images": "node scripts/publish-images.mjs",
    "voces": "node scripts/voces-generar.mjs",
    "copiar:turso": "node scripts/copiar-turso.mjs",
    "download:images": "node scripts/descargar-imagenes.mjs",
    "admin:hash": "node scripts/admin-hash.mjs",
    "admin:publicar": "node scripts/publicar-admin-prod.mjs",
    "admin:verificar": "node scripts/verificar-admin-prod.mjs",
    "ficha:prod": "node scripts/aplicar-ficha-prod.mjs",
    "correos:vista": "node scripts/vista-correos.mjs",
    "informe:habilidades": "node scripts/informe-habilidades.mjs",
    "informe:experiencia": "node scripts/informe-experiencia.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "next": "^16.3.5",
    "nodemailer": "^10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
