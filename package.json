{
  "name": "vtuberdex",
  "private": true,
  "version": "0.1.0",
  "description": "VTuberDex: catálogo de VTubers hispanohablantes con carta holográfica 3D",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-db.mjs --if-missing && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:shaders": "node scripts/check-shaders.mjs",
    "verify": "node scripts/verify-vercel-bundle.mjs",
    "probe:timings": "node scripts/probe-timings.mjs",
    "bench:ediciones": "node scripts/bench-ediciones.mjs",
    "sweep:dead-code": "node scripts/sweep-dead-code.mjs",
    "build:data": "node scripts/build-db.mjs",
    "publish:images": "node scripts/publish-images.mjs",
    "voces": "node scripts/voces-generar.mjs",
    "copiar:turso": "node scripts/copiar-turso.mjs",
    "download:images": "node scripts/descargar-imagenes.mjs",
    "admin:hash": "node scripts/admin-hash.mjs",
    "admin:publicar": "node scripts/publicar-admin-prod.mjs",
    "admin:verificar": "node scripts/verificar-admin-prod.mjs",
    "ficha:prod": "node scripts/aplicar-ficha-prod.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "^16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.180.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
